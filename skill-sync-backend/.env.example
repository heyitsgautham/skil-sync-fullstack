# SkillSync backend environment variables.
# Copy this file to .env and fill in real values. .env is gitignored.

# Database
DATABASE_URL=postgresql://skillsync:skillsync@localhost:5432/skillsync

# JWT signing for login tokens. Generate a key with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Signing key for the short-lived resume view links
TEMP_TOKEN_SECRET=replace-with-another-openssl-rand-hex-32

# Server port for `python -m app.main`
PORT=8000

# Logging. LOG_FORMAT=json writes one JSON object per line.
LOG_LEVEL=INFO
LOG_FORMAT=plain

# CORS, comma-separated. Leave empty to allow every origin.
ALLOWED_ORIGINS=http://localhost:3000

# Public URLs used in emails and resume view links
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Gemini API keys, one per task so each task has its own rate limit.
# Get keys at https://aistudio.google.com/app/apikey
GEMINI_KEY_RESUME_PARSING=
GEMINI_KEY_MATCHING_EXPLANATION=
GEMINI_KEY_SKILLS_EXTRACTION=
GEMINI_KEY_EMBEDDING_GENERATION=
GEMINI_KEY_CANDIDATE_SUMMARY=
GEMINI_KEY_INTERNSHIP_ANALYSIS=
GEMINI_KEY_ACHIEVEMENT_EXTRACTION=
GEMINI_KEY_FALLBACK_1=
GEMINI_KEY_FALLBACK_2=
GEMINI_KEY_FALLBACK_3=

# Only the scripts in scripts/ read this one
GOOGLE_API_KEY=

# ChromaDB vector store directory
CHROMA_DB_PATH=./data/chroma_db

# AWS S3 resume storage. Leave the keys empty to store resumes in app/public/resumes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=skillsync-resumes

# SMTP for notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=SkillSync

# Password for every account scripts/seed_demo_data.py creates, at least 8 characters.
# Leave it empty and the script generates one and prints it.
SEED_PASSWORD=

# Optional error tracking. Leave SENTRY_DSN empty to send nothing anywhere.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Share of requests traced for performance, 0 to 1. 0 turns tracing off.
SENTRY_TRACES_SAMPLE_RATE=0
